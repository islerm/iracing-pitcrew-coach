{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pitcrew-ui",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--", "--ui-port", "8787"],
      "port": 8787
    },
    {
      "name": "pitcrew-ui-replay",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--release", "--", "--ui-port", "8790", "--replay", "tests/fixtures/roadatlanta-full.ibt", "--replay-speed", "8"],
      "port": 8790
    },
    {
      "name": "pitcrew-ui-test",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--release", "--", "--ui-port", "8791", "--no-auto-record", "--model", "no-such-model"],
      "port": 8791
    }
  ]
}
